# Copie para .env antes de usar docker compose. Gere um JWT_SECRET aleatorio.
# No Compose, os enderecos do banco e Redis sao configurados automaticamente
# entre containers; SPRING_* abaixo servem para iniciar a aplicacao fora do Docker.

# Banco de dados (Spring Boot local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/valora
SPRING_DATASOURCE_USERNAME=valora
SPRING_DATASOURCE_PASSWORD=valora

# Redis (Spring Boot local)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# JWT (obrigatorio em prod e no docker compose). Exemplo de geracao:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# BRAPI (opcional; crie uma conta em https://brapi.dev/ para obter o token).
# Sem token, a cotacao fica indisponivel e o resumo sinaliza o valor provisório.
BRAPI_TOKEN=

# Sincronizacao de proventos (opcional)
PROVENTS_SYNC_CRON=0 15 8 * * *
PROVENTS_SYNC_ASSET_LOOKBACK_DAYS=365
PROVENTS_SYNC_JCP_RATE_IS_GROSS=true

